# Set these in Vercel → Project → Settings → Environment Variables

# Production API (Express/Railway/Fly etc.) — no trailing slash
VITE_API_URL="https://api.anuvawellness.com"
VITE_FREE_TRIAL_DAYS="14"

# When frontend and API are cross-site, the API cookie must use:
# SESSION_COOKIE_SAME_SITE="none"
# SESSION_COOKIE_SECURE="true"
#
# When they are same-site (for example app.example.com + api.example.com),
# SESSION_COOKIE_SAME_SITE="lax" is usually enough.

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_VAPID_KEY=""
