# Postgres connection string (local install, cloud host, etc.)
DATABASE_URL="postgresql://sreekanthmk:frefrefr@localhost:5432/ferf?sslmode=disable"

# 2Factor SMS OTP
TWOFACTOR_API_KEY="frefer-frefrfref-fref-9800-0200cd936042"
TWOFACTOR_BASE_URL="https://2factor.in/API/V1"
TWOFACTOR_OTP_TEMPLATE_NAME="OTP1"

# Auth session + OTP settings
SESSION_COOKIE_NAME="anuva_session"
SESSION_TTL_DAYS="30"
SESSION_COOKIE_SECURE="false"
FREE_TRIAL_DAYS="14"
VITE_FREE_TRIAL_DAYS="14"
OTP_EXPIRY_MINUTES="10"
OTP_RESEND_COOLDOWN_SECONDS="30"
OTP_MAX_SENDS_PER_15_MINUTES="3"
OTP_MAX_VERIFY_ATTEMPTS="5"

# Firebase Cloud Messaging (PWA web push) — from Firebase Console → Project settings
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Cloud Messaging → Web Push certificates (key pair)
VITE_FIREBASE_VAPID_KEY=""

# FCM send from API — Firebase Console → Project settings → Service accounts → Generate new private key
# Easiest: save the downloaded JSON as firebase-service-account.json in repo root (gitignored)
# FIREBASE_SERVICE_ACCOUNT_PATH="firebase-service-account.json"
# Or paste the whole JSON as one line:
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Secret for GET /push/hello-world?secret=...
PUSH_BROADCAST_SECRET="change-me-in-production"

# LiveKit self-hosted consultation calls
# Local dev:
LIVEKIT_URL="ws://127.0.0.1:7880"
# Production should be wss://your-livekit-domain
# LIVEKIT_URL="wss://livekit.example.com"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret"
LIVEKIT_TOKEN_TTL="2h"
LIVEKIT_RECORDING_ENABLED="true"
LIVEKIT_RECORDING_AUDIO_ONLY="true"
LIVEKIT_RECORDING_FILE_PREFIX="consultation-recordings"
CALL_CONSENT_TEXT_VERSION="recording-consent-v1"

# Admin panel (/admin API + apps/admin UI). Password for POST /admin/auth/login.
# Session tokens are HMAC-signed with ADMIN_SESSION_SECRET (required in production).
# Unset ADMIN_PASSWORD ⇒ all admin logins fail closed.
ADMIN_PASSWORD="change-me-in-production"
ADMIN_SESSION_SECRET="change-me-to-a-long-random-secret"
ADMIN_SESSION_TTL_HOURS="12"

# Admin key for the /doctor API routes. The doctor PWA sends it as x-doctor-key.
# This key sees EVERY doctor's bookings and can rotate per-doctor keys:
#   curl -X POST -H "x-doctor-key: $DOCTOR_ACCESS_KEY" \
#     http://localhost:3001/doctor/specialists/kekin-gala/access-key
# Individual doctors sign in with their own key instead and only see their own bookings.
# Unset means no request can claim admin scope; doctor keys still work. Use a long random value.
DOCTOR_ACCESS_KEY="change-me-in-production"

# How many anonymous questions one account may ask per rolling 24h. The queue is shared across
# all specialists, so this is the flood guard. Defaults to 5.
ANONYMOUS_QA_DAILY_LIMIT="5"

# Where the egress recording volume lands on the API filesystem (used for the ffmpeg mixdown).
# Unset disables mixdown; the per-speaker recordings still work.
RECORDING_LOCAL_DIR="/var/lib/anuva/consultation-recordings"

# Where doctor-uploaded prescriptions and diet plans are stored. These are medical records, so
# point this at a backed-up volume. Unset falls back to <repo>/.data/consultation-documents.
CONSULTATION_DOC_DIR="/var/lib/anuva/consultation-documents"

# ANU chat (OpenAI) — platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ANU_CHAT_MODEL="gpt-4o-mini"
ANU_EMBED_MODEL="text-embedding-3-small"
# Cosine score a cached reply must beat to be reused. Tight on purpose: a
# near-miss serves a clinically wrong answer with cache confidence.
ANU_CACHE_THRESHOLD="0.94"
ANU_CACHE_MAX_ENTRIES="20000"
# How often each worker reloads the cache index from Postgres (ms).
ANU_CACHE_REFRESH_MS="120000"

# Logging. LOG_LEVEL: trace|debug|info|warn|error|fatal (default info — debug adds per-user
# nudge suppression lines). LOG_FORMAT: pretty (default, readable in the Coolify Logs tab) or
# json, for once logs ship to an aggregator.
LOG_LEVEL="info"
LOG_FORMAT="pretty"
