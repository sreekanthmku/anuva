# Postgres connection string (local install, cloud host, etc.)
DATABASE_URL="postgresql://sreekanthmk:frefrefr@localhost:5432/ferf?sslmode=disable"

# 2Factor SMS OTP
TWOFACTOR_API_KEY="frefer-frefrfref-fref-9800-0200cd936042"
TWOFACTOR_BASE_URL="https://2factor.in/API/V1"
TWOFACTOR_OTP_TEMPLATE_NAME="OTP1"

# Auth session + OTP settings
SESSION_COOKIE_NAME="anuva_session"
SESSION_TTL_DAYS="30"
SESSION_COOKIE_SECURE="false"
FREE_TRIAL_DAYS="14"
VITE_FREE_TRIAL_DAYS="14"
OTP_EXPIRY_MINUTES="10"
OTP_RESEND_COOLDOWN_SECONDS="30"
OTP_MAX_SENDS_PER_15_MINUTES="3"
OTP_MAX_VERIFY_ATTEMPTS="5"

# Firebase Cloud Messaging (PWA web push) — from Firebase Console → Project settings
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Cloud Messaging → Web Push certificates (key pair)
VITE_FIREBASE_VAPID_KEY=""

# FCM send from API — Firebase Console → Project settings → Service accounts → Generate new private key
# Easiest: save the downloaded JSON as firebase-service-account.json in repo root (gitignored)
# FIREBASE_SERVICE_ACCOUNT_PATH="firebase-service-account.json"
# Or paste the whole JSON as one line:
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Secret for GET /push/hello-world?secret=...
PUSH_BROADCAST_SECRET="change-me-in-production"

# LiveKit self-hosted consultation calls
# Local dev:
LIVEKIT_URL="ws://127.0.0.1:7880"
# Production should be wss://your-livekit-domain
# LIVEKIT_URL="wss://livekit.example.com"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret"
LIVEKIT_TOKEN_TTL="2h"
LIVEKIT_RECORDING_ENABLED="true"
LIVEKIT_RECORDING_AUDIO_ONLY="true"
LIVEKIT_RECORDING_FILE_PREFIX="consultation-recordings"
CALL_CONSENT_TEXT_VERSION="recording-consent-v1"

# Admin panel (/admin API + apps/admin UI). Password for POST /admin/auth/login.
# Session tokens are HMAC-signed with ADMIN_SESSION_SECRET (required in production).
# Unset ADMIN_PASSWORD ⇒ all admin logins fail closed.
ADMIN_PASSWORD="change-me-in-production"
ADMIN_SESSION_SECRET="change-me-to-a-long-random-secret"
ADMIN_SESSION_TTL_HOURS="12"

# Doctor portal sessions. Doctors sign in at POST /doctor/auth/login with a username and password;
# the credentials live on the Specialist row and are set in the admin panel under
# "Specialist Logins". A specialist with portalRole=doctor sees only their own bookings; one with
# portalRole=admin is an ops login that sees every booking and is hidden from the booking catalog.
# There is no shared key any more.
# The cookie reuses the SESSION_COOKIE_* settings above and only differs by name.
DOCTOR_SESSION_COOKIE_NAME="anuva_doctor_session"
DOCTOR_SESSION_TTL_HOURS="12"

# How many anonymous questions one account may ask per rolling 24h. The queue is shared across
# all specialists, so this is the flood guard. Defaults to 5.
ANONYMOUS_QA_DAILY_LIMIT="5"

# Where the egress recording volume lands on the API filesystem (used for the ffmpeg mixdown).
# Unset disables mixdown; the per-speaker recordings still work.
RECORDING_LOCAL_DIR="/var/lib/anuva/consultation-recordings"

# Where doctor-uploaded prescriptions and diet plans are stored. These are medical records, so
# point this at a backed-up volume. Unset falls back to <repo>/.data/consultation-documents.
CONSULTATION_DOC_DIR="/var/lib/anuva/consultation-documents"

# ANU chat (OpenAI) — platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# gpt-5-mini: measured to hold the voice rules that gpt-4o-mini drops (no
# wellness filler, no tracking offer every turn, no question every turn).
# Swapping families is safe — openai.ts picks the sampling params to match.
ANU_CHAT_MODEL="gpt-5-mini"
ANU_EMBED_MODEL="text-embedding-3-small"
# Cosine score a cached reply must beat to be reused. Tight on purpose: a
# near-miss serves a clinically wrong answer with cache confidence. At 0.94
# paraphrases of the same opening message were answered from each other, which
# made first replies read generic. Raise, never lower, without an eval.
ANU_CACHE_THRESHOLD="0.97"
ANU_CACHE_MAX_ENTRIES="20000"
# How often each worker reloads the cache index from Postgres (ms).
ANU_CACHE_REFRESH_MS="120000"

# Logging. LOG_LEVEL: trace|debug|info|warn|error|fatal (default info — debug adds per-user
# nudge suppression lines). LOG_FORMAT: pretty (default, readable in the Coolify Logs tab) or
# json, for once logs ship to an aggregator.
LOG_LEVEL="info"
LOG_FORMAT="pretty"

# ─────────────────────────────────────────────
# Family sharing (apps/family-pwa)
# ─────────────────────────────────────────────

# REQUIRED. Signs the invite magic links: a token is <inviteId>.<HMAC-SHA256(this, inviteId)>, so
# nothing secret is stored in the database and a dump alone yields no working link. Must be at
# least 32 characters or every /family/* route returns 503. Generate with:
#   openssl rand -hex 32
# Rotating it invalidates every outstanding invite at once — that is the emergency lever, so set it
# once and leave it alone.
FAMILY_INVITE_SECRET="replace-me-openssl-rand-hex-32-at-least-32-chars"

# REQUIRED in production. Origin of the family PWA, used to build the link she shares. The token
# goes in the URL fragment (/join#t=...), so it never reaches a server or CDN access log.
# Defaults to http://localhost:5175 for local dev.
FAMILY_PWA_BASE_URL="https://family.anuvawellness.com"

# How long an invite link stays claimable. Defaults to 7.
FAMILY_INVITE_TTL_DAYS="7"

# How long a share buys before the blocking invite gate re-opens on her home screen. The product
# rule is "come back in 5-10 minutes"; the default sits in the middle. Measured from
# FamilyInvite.sharedAt in Postgres, not a client timer, so a reload cannot extend it.
# Set to 1 when testing the gate, or you wait seven minutes per attempt.
FAMILY_REPROMPT_MINUTES="7"

# How long a family member stays signed in. Long on purpose: they are not the daily user, and
# re-verifying by SMS every fortnight would just make them stop opening it. Access still ends
# immediately if she revokes them or opts out — checked on every request. Defaults to 90.
FAMILY_SESSION_TTL_DAYS="90"

# Separate from SESSION_COOKIE_NAME so she and her partner can both be signed in on one browser
# without either session standing on the other. Reuses the SESSION_COOKIE_* SameSite/secure/domain
# settings above and only differs by name.
FAMILY_SESSION_COOKIE_NAME="anuva_family_session"
