{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "db:generate": {
      "cache": false,
      "outputs": ["**/node_modules/.prisma/**", "**/node_modules/@prisma/client/**"]
    }
  }
}
