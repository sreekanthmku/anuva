{
  "name": "@anuva/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/prisma-with-root-env.mjs migrate dev",
    "db:deploy": "node scripts/prisma-with-root-env.mjs migrate deploy",
    "db:status": "node scripts/prisma-with-root-env.mjs migrate status",
    "db:push": "node scripts/prisma-with-root-env.mjs db push",
    "db:indexes": "node scripts/prisma-with-root-env.mjs db execute --file prisma/sql/partial-indexes.sql --schema prisma/schema.prisma",
    "lint": "echo \"no lint\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prisma": "^6.19.3",
    "typescript": "^5.7.2"
  }
}
