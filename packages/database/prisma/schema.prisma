generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Auth & user
// ─────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  phone               String    @unique
  name                String?
  email               String?   @unique
  phoneVerifiedAt     DateTime?
  onboardingCompleted Boolean   @default(false)
  dieticianPlanAssigned Boolean @default(false)
  familyFeatureOptOut Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions          Session[]
  otpChallenges     OtpChallenge[]
  healthProfile     HealthProfile?
  assessments       Assessment[]
  subscription      Subscription?
  wellnessSnapshots WellnessSnapshot[]
  symptomLogs       SymptomLog[]
  weeklyReports     WeeklyReport[]
  userCarePaths     UserCarePath[]
  journeyStages     CareJourneyStage[]
  consultations     Consultation[]
  callConsents      ConsultationCallConsent[]
  questions         AnonymousQuestion[]
  chatThreads       ChatThread[]
  fcmTokens         FcmToken[]
  cycleSettings      CycleSettings?
  periodLogs         PeriodLog[]
  moodLogs           MoodLog[]
  sleepLogs          SleepLog[]
  quickSymptomLogs   QuickSymptomLog[]
  detailedAssessment DetailedAssessment?
  energyLogs         EnergyLog[]
  stressLogs         StressLog[]
  hotFlashDailyLogs  HotFlashDailyLog[]
  periodDailyStatuses PeriodDailyStatus[]
  planAdherenceLogs  PlanAdherenceLog[]
  hydrationLogs      HydrationLog[]
  cravingsLogs       CravingsLog[]
  movementLogs       MovementLog[]
  meTimeLogs         MeTimeLog[]
  foodRhythmLogs     FoodRhythmLog[]
  familySupportLogs  FamilySupportLog[]
  weeklyMoodReviews  WeeklyMoodReviewLog[]
  brainFogLogs       BrainFogLog[]
  bloatingLogs       BloatingLog[]
  painLogs           PainLog[]
  nudgeDailyStates   NudgeDailyState[]
  nudgeSendLogs      NudgeSendLog[]
  l3TriggerLogs      L3TriggerLog[]
}

enum FcmPlatform {
  WEB
  ANDROID
  IOS
}

enum FcmTokenStatus {
  ACTIVE
  INACTIVE
}

model FcmToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String         @unique
  platform  FcmPlatform
  status    FcmTokenStatus @default(ACTIVE)
  deviceId  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, status])
}

model Session {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
}

enum OtpChallengePurpose {
  login
  signup
}

enum OtpChallengeStatus {
  pending
  verified
  expired
  failed
}

model OtpChallenge {
  id                String             @id @default(cuid())
  phone             String
  userId            String?
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  purpose           OtpChallengePurpose
  provider          String
  providerSessionId String
  status            OtpChallengeStatus @default(pending)
  attemptCount      Int                @default(0)
  expiresAt         DateTime
  verifiedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([phone, createdAt])
  @@index([userId])
  @@index([status, expiresAt])
}

enum MenopauseStage {
  premenopause
  perimenopause
  menopause
  postmenopause
}

model HealthProfile {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth    DateTime?
  menopauseStage MenopauseStage?
  cycleStartDate DateTime?
  updatedAt      DateTime        @updatedAt
}

// ─────────────────────────────────────────────
// Onboarding assessment
// ─────────────────────────────────────────────

model AssessmentQuestion {
  id      String              @id @default(cuid())
  key     String              @unique
  prompt  String
  order   Int
  options AssessmentOption[]
  answers AssessmentAnswer[]
}

model AssessmentOption {
  id         String             @id @default(cuid())
  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  score      Int
  order      Int

  @@index([questionId])
}

enum AssessmentStatus {
  in_control
  further_assessment
}

model Assessment {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Int
  threshold   Int                @default(8)
  status      AssessmentStatus
  completedAt DateTime           @default(now())
  answers     AssessmentAnswer[]

  @@index([userId])
}

model AssessmentAnswer {
  id           String             @id @default(cuid())
  assessmentId String
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     AssessmentQuestion @relation(fields: [questionId], references: [id])
  optionIndex  Int
  optionLabel  String
  score        Int

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
}

// ─────────────────────────────────────────────
// Subscription
// ─────────────────────────────────────────────

enum SubscriptionPlan {
  monthly
  annual
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan?
  status    SubscriptionStatus @default(active)
  startedAt DateTime           @default(now())
  trialEndsAt DateTime?
  renewsAt  DateTime?
}

// ─────────────────────────────────────────────
// Dashboard
// ─────────────────────────────────────────────

model WellnessSnapshot {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  balanceScore Int
  summary      String?

  @@unique([userId, date])
  @@index([userId])
}

model DailyInsight {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  body       String
  authorName String?
  source     String?
  createdAt  DateTime @default(now())

  @@index([date])
}

// ─────────────────────────────────────────────
// Symptom tracking
// ─────────────────────────────────────────────

enum SymptomCategory {
  vasomotor
  sleep
  mood
  lifestyle
}

model Symptom {
  id       String              @id @default(cuid())
  key      String              @unique
  label    String
  category SymptomCategory
  active   Boolean             @default(true)
  entries  SymptomLogEntry[]
}

model SymptomLog {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime          @db.Date
  intensity Int // 1-7 overall intensity
  note      String?
  createdAt DateTime          @default(now())
  entries   SymptomLogEntry[]

  @@unique([userId, date])
  @@index([userId])
}

model SymptomLogEntry {
  id        String     @id @default(cuid())
  logId     String
  log       SymptomLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  symptomId String
  symptom   Symptom    @relation(fields: [symptomId], references: [id])

  @@unique([logId, symptomId])
  @@index([logId])
}

// ─────────────────────────────────────────────
// Weekly report
// ─────────────────────────────────────────────

model WeeklyReport {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime        @db.Date
  weekEnd   DateTime        @db.Date
  cohort    String? // e.g. "women 42-50 early perimenopause"
  createdAt DateTime        @default(now())
  metrics   WeeklyMetric[]

  @@unique([userId, weekStart])
  @@index([userId])
}

enum MetricKind {
  benchmark
  stat
}

model WeeklyMetric {
  id          String       @id @default(cuid())
  reportId    String
  report      WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  kind        MetricKind
  label       String
  value       Float
  unit        String?
  delta       String?
  cohortMedup Float? // cohort median for benchmark bars
  trend       Int[] // sparkline series for stat cards

  @@index([reportId])
}

// ─────────────────────────────────────────────
// Care direction
// ─────────────────────────────────────────────

model CarePath {
  id          String         @id @default(cuid())
  key         String         @unique
  label       String
  tag         String?
  description String?
  users       UserCarePath[]
}

enum CarePathStatus {
  recommended
  selected
  active
  completed
}

model UserCarePath {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  carePathId String
  carePath   CarePath       @relation(fields: [carePathId], references: [id])
  status     CarePathStatus @default(recommended)
  focusTags  String[]
  createdAt  DateTime       @default(now())

  @@unique([userId, carePathId])
  @@index([userId])
}

enum JourneyStageStatus {
  done
  active
  upcoming
}

model CareJourneyStage {
  id     String             @id @default(cuid())
  userId String
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage  String
  status JourneyStageStatus @default(upcoming)
  order  Int

  @@index([userId])
}

// ─────────────────────────────────────────────
// Specialists & booking
// ─────────────────────────────────────────────

model Specialist {
  id             String                    @id @default(cuid())
  key            String                    @unique // gynec | psych | nutri | riz
  name           String
  subtitle       String?
  role           String?
  specialization String?
  summary        String?
  experience     String?
  tag            String?
  imageUrl       String?
  active         Boolean                   @default(true)
  qualifications SpecialistQualification[]
  consultations  Consultation[]
  slots          ConsultationSlot[]
}

model SpecialistQualification {
  id           String     @id @default(cuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  label        String

  @@index([specialistId])
}

enum ConsultationStatus {
  pending
  confirmed
  completed
  cancelled
}

enum ConsultationCallProvider {
  livekit
}

enum ConsultationCallStatus {
  waiting
  active
  ended
  failed
}

enum ConsultationRecordingStatus {
  starting
  recording
  processing
  ready
  failed
}

enum ConsultationRecordingRole {
  doctor
  patient
  /// Derived: the doctor and patient files mixed down to one track with ffmpeg. Has no egress
  /// of its own, so egressId stays null.
  mixed
}

model Consultation {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialistId String
  specialist   Specialist         @relation(fields: [specialistId], references: [id])
  scheduledAt  DateTime
  status       ConsultationStatus @default(pending)
  isFree       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  slot         ConsultationSlot?
  call         ConsultationCall?

  @@index([userId])
  @@index([specialistId])
}

model ConsultationCall {
  id                 String                   @id @default(cuid())
  consultationId     String                   @unique
  consultation       Consultation             @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  provider           ConsultationCallProvider @default(livekit)
  roomName           String                   @unique
  status             ConsultationCallStatus   @default(waiting)
  doctorStartedAt    DateTime?
  patientJoinedAt    DateTime?
  recordingStartedAt DateTime?
  endedAt            DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  recordings         ConsultationRecording[]
  consents           ConsultationCallConsent[]

  @@index([status])
}

/// One row per participant. Each speaker is recorded to its own audio file via
/// LiveKit participant egress, so Phase 2 transcription gets speaker-separated
/// audio without a diarization step.
model ConsultationRecording {
  id                  String                      @id @default(cuid())
  consultationCallId  String
  consultationCall    ConsultationCall            @relation(fields: [consultationCallId], references: [id], onDelete: Cascade)
  participantRole     ConsultationRecordingRole
  participantIdentity String
  egressId            String?                     @unique
  status              ConsultationRecordingStatus @default(starting)
  storagePath         String?
  startedAt           DateTime?
  completedAt         DateTime?
  durationSeconds     Int?
  errorMessage        String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([consultationCallId, participantRole])
  @@index([status])
}

model ConsultationCallConsent {
  id                 String           @id @default(cuid())
  consultationCallId String
  consultationCall   ConsultationCall @relation(fields: [consultationCallId], references: [id], onDelete: Cascade)
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentTextVersion String
  consentedAt        DateTime         @default(now())

  @@unique([consultationCallId, userId])
  @@index([userId])
}

model ConsultationSlot {
  id             String        @id @default(cuid())
  specialistId   String
  specialist     Specialist    @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  isBooked       Boolean       @default(false)
  consultationId String?       @unique
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@unique([specialistId, startsAt])
  @@index([specialistId, startsAt])
}

// ─────────────────────────────────────────────
// Library
// ─────────────────────────────────────────────

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  category    String
  title       String
  excerpt     String?
  body        String?
  readMinutes Int?
  authorName  String?
  featured    Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([category])
}

model Masterclass {
  id          String   @id @default(cuid())
  title       String
  scheduledAt DateTime
  isFree      Boolean  @default(true)
  isLive      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────
// Anonymous Q&A
// ─────────────────────────────────────────────

enum QuestionStatus {
  pending
  answered
}

model AnonymousQuestion {
  id        String         @id @default(cuid())
  userId    String? // nullable: anonymity preserved
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  topic     String
  body      String
  status    QuestionStatus @default(pending)
  createdAt DateTime       @default(now())
  answers   ExpertAnswer[]

  @@index([topic])
  @@index([status])
}

model ExpertAnswer {
  id         String            @id @default(cuid())
  questionId String
  question   AnonymousQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  expertName String
  expertRole String?
  body       String
  verified   Boolean           @default(false)
  answeredAt DateTime          @default(now())

  @@index([questionId])
}

// ─────────────────────────────────────────────
// Anu chat
// ─────────────────────────────────────────────

enum ChatRole {
  user
  anu
}

model ChatThread {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      ChatRole
  body      String
  createdAt DateTime   @default(now())

  @@index([threadId])
}

// ─────────────────────────────────────────────
// Cycle tracking
// ─────────────────────────────────────────────

model CycleSettings {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleLength  Int      @default(28)
  periodLength Int      @default(5)
  updatedAt    DateTime @updatedAt
}

model PeriodLog {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  createdAt DateTime  @default(now())

  @@unique([userId, startDate])
  @@index([userId])
}

model MoodLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeling   Int? // 1..5 (manual sheet)
  emotions  String[] // emotion enum values
  category  String? // nudge L1-003 categorical answer
  slot      String? // morning | evening
  moodShift String? // nudge L1-008 evening mood-shift answer
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, loggedAt])
}

model SleepLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quality        Int? // 1..5 (manual sheet)
  hours          String? // hours bucket enum value
  disruptions    String[] // disruption enum values
  category       String? // nudge L1-001 categorical answer
  nightSweatFlag Boolean  @default(false)
  loggedAt       DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([userId, loggedAt])
}

model QuickSymptomLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symptom  String // quick symptom enum value
  loggedAt DateTime @default(now())

  @@index([userId, loggedAt])
}

// ─────────────────────────────────────────────
// Detailed assessment (Perimenopause Health Questionnaire)
// ─────────────────────────────────────────────

enum DetailedAssessmentStatus {
  in_progress
  completed
}

model DetailedAssessment {
  id          String                   @id @default(cuid())
  userId      String                   @unique
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      DetailedAssessmentStatus @default(in_progress)
  startedAt   DateTime                 @default(now())
  completedAt DateTime?
  updatedAt   DateTime                 @updatedAt
  answers     DetailedAnswer[]
}

model DetailedAnswer {
  id           String             @id @default(cuid())
  assessmentId String
  assessment   DetailedAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionKey  String
  value        String

  @@unique([assessmentId, questionKey])
  @@index([assessmentId])
}

// ─────────────────────────────────────────────
// Nudge engine — daily tracker logs
// Categorical answers captured by the ANU nudge cards.
// source: "nudge" (answered via card) | "manual" (self-logged)
// ─────────────────────────────────────────────

model EnergyLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  category  String // L1-002 answer
  source    String   @default("nudge")
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model StressLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  category     String // L1-004 answer
  overwhelmed  Boolean  @default(false) // sets distress_flag
  source       String   @default("nudge")
  loggedAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model HotFlashDailyLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  category  String // L1-005 bucket: none | 1-2 | 3-5 | more_than_5 | not_sure
  count     Int? // numeric estimate when derivable
  source    String   @default("nudge")
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model PeriodDailyStatus {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  category  String // L1-006 answer
  source    String   @default("nudge")
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model PlanAdherenceLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  category  String // L1-007 answer
  source    String   @default("nudge")
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model HydrationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  category  String // L2-001 answer
  source    String   @default("nudge")
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model CravingsLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  category  String // L2-002 answer
  source    String   @default("nudge")
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model MovementLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  category  String // L2-006 answer
  source    String   @default("nudge")
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model MeTimeLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  category  String // L2-007 answer
  source    String   @default("nudge")
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model FoodRhythmLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  category  String // L2-009 answer
  source    String   @default("nudge")
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model FamilySupportLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date // Sunday the week was logged
  category  String // L2-008 weekly answer
  source    String   @default("nudge")
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model WeeklyMoodReviewLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date // Fri/Sat the week was logged
  category  String // L2-010 primary concern
  source    String   @default("nudge")
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model BrainFogLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  category  String // L2-003 answer
  source    String   @default("nudge")
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model BloatingLog {
