// ─────────────────────────────────────────────
// Nudge engine — governor state & send history
// ─────────────────────────────────────────────

model NudgeDailyState {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                   DateTime @db.Date
  nudgeCount             Int      @default(0)
  morningAnchorResponded Boolean  @default(false)
  afternoonResponded     Boolean  @default(false)
  distressFlag           Boolean  @default(false)
  lastEngagedAt          DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model NudgeSendLog {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nudgeId          String // e.g. L1-001, L2-003
  layer            Int // 1 | 2 | 3
  slot             String // morning | afternoon | evening
  sentAt           DateTime  @default(now())
  engagedAt        DateTime?
  suppressedReason String? // set when a candidate was gated (SR-xx)

  @@index([userId, sentAt])
  @@index([userId, nudgeId, sentAt])
}

model L3TriggerLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggerId String // L3-001 .. L3-009
  firedAt   DateTime @default(now())

  @@index([userId, triggerId, firedAt])
}
