// ─────────────────────────────────────────────
// ANU chat
// ─────────────────────────────────────────────

enum AnuTurnSource {
  red_flag
  cache
  model
}

/// Immutable audit trail. Records what ANU actually said to whom, and why.
/// The reply is snapshotted rather than joined so a later prompt or content
/// change cannot rewrite history.
model AnuChatTurn {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMessage   String
  reply         String
  /// Follow-up chips offered with this reply, so reopening the thread restores
  /// the same choices the user was given at the time.
  suggestions   String[]
  /// Bank symptom label this turn was about, used to keep follow-ups anchored
  /// to the same topic. Null for greetings and anything off-list.
  symptom       String?
  source        AnuTurnSource
  redFlagArea   String? // set when the deterministic gate fired
  cacheHitId    String? // AnuResponseCache.id when served from cache
  similarity    Float? // cosine score of the cache lookup, when one ran
  promptVersion Int
  createdAt     DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Semantic response cache. `embedding` is a raw float32 buffer (512 dims);
/// vectors are scanned in memory, never in SQL, so no pgvector extension is
/// needed. Postgres is the durable store that repopulates the index on boot.
model AnuResponseCache {
  id            String   @id @default(cuid())
  question      String
  reply         String
  /// Cached alongside the reply — chips and the symptom are derived with it and
  /// would otherwise be lost on a cache hit, leaving the next follow-up with no
  /// topic to anchor to.
  suggestions   String[]
  symptom       String?
  embedding     Bytes
  promptVersion Int
  hits          Int      @default(0)
  lastUsedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([promptVersion])
  @@index([lastUsedAt])
}

// ─────────────────────────────────────────────
// Help & support
// ─────────────────────────────────────────────

enum SupportTicketCategory {
  account
  consultation
  subscription
  technical
  privacy
  other
}

enum SupportTicketStatus {
  open
  in_progress
  resolved
  closed
}

/// A help request written from the app. Stored here and answered from the admin panel — nothing
/// is emailed out, so what she writes stays inside systems we control and can honour an erasure
/// request against.
///
/// `userId` is nullable on purpose: deleting an account detaches the ticket rather than cascading,
/// so the support history stays auditable while ceasing to be about a person. Anything that could
/// identify her (`subject`, `message`, `contactEmail`) is scrubbed at the same time.
model SupportTicket {
  id     String @id @default(cuid())
  /// Short quotable reference shown in the app, e.g. ANV-7K3P2Q.
  reference String @unique
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  category SupportTicketCategory
  subject  String
  message  String
  /// Only present when she chose to be reached by email. Never copied from the account record.
  contactEmail String?

  status SupportTicketStatus @default(open)
  /// The reply written from the admin panel. She reads it in the app.
  response    String?
  respondedAt DateTime?

  /// Which consent notice was on screen when she submitted, so a later reword does not rewrite
  /// what she agreed to.
  consentVersion String
  /// Where it came from, for reproducing bugs. No device fingerprint, no IP.
  appVersion String?

  /// Set at creation from the retention policy. The purge job deletes rows past this date, which
  /// makes the promise in the consent notice provable rather than aspirational.
  purgeAfter DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([purgeAfter])
}
