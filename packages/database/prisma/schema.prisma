generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Auth & user
// ─────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  phone               String    @unique
  name                String?
  email               String?   @unique
  phoneVerifiedAt     DateTime?
  onboardingCompleted Boolean   @default(false)
  dieticianPlanAssigned Boolean @default(false)
  familyFeatureOptOut Boolean   @default(false)
  /// Set when a DPDP erasure completes. The row survives so the consultation records the NMC
  /// requires us to keep for three years still resolve to a patient, but it carries no personal
  /// data any more: `phone` is rewritten to `erased:<id>`, `email` and `name` are nulled. Every
  /// auth path must refuse a user with this set — the account is a tombstone, not an account.
  erasedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions          Session[]
  otpChallenges     OtpChallenge[]
  healthProfile     HealthProfile?
  assessments       Assessment[]
  subscription      Subscription?
  wellnessSnapshots WellnessSnapshot[]
  symptomLogs       SymptomLog[]
  weeklyReports     WeeklyReport[]
  userCarePaths     UserCarePath[]
  journeyStages     CareJourneyStage[]
  consultations     Consultation[]
  callConsents      ConsultationCallConsent[]
  questions         AnonymousQuestion[]
  chatThreads       ChatThread[]
  fcmTokens         FcmToken[]
  cycleSettings      CycleSettings?
  periodLogs         PeriodLog[]
  periodFlowLogs     PeriodFlowLog[]
  moodLogs           MoodLog[]
  sleepLogs          SleepLog[]
  quickSymptomLogs   QuickSymptomLog[]
  detailedAssessment DetailedAssessment?
  energyLogs         EnergyLog[]
  stressLogs         StressLog[]
  hotFlashDailyLogs  HotFlashDailyLog[]
  periodDailyStatuses PeriodDailyStatus[]
  planAdherenceLogs  PlanAdherenceLog[]
  hydrationLogs      HydrationLog[]
  cravingsLogs       CravingsLog[]
  movementLogs       MovementLog[]
  meTimeLogs         MeTimeLog[]
  foodRhythmLogs     FoodRhythmLog[]
  familySupportLogs  FamilySupportLog[]
  weeklyMoodReviews  WeeklyMoodReviewLog[]
  brainFogLogs       BrainFogLog[]
  bloatingLogs       BloatingLog[]
  painLogs           PainLog[]
  nudgeDailyStates   NudgeDailyState[]
  nudgeSendLogs      NudgeSendLog[]
  l3TriggerLogs      L3TriggerLog[]
  anuChatTurns       AnuChatTurn[]
  supportTickets     SupportTicket[]
  deletionRequests   DataDeletionRequest[]
  dataExports        DataExportRequest[]
  familyInvites        FamilyInvite[]
  familyMembers        FamilyMember[]
  familySupportActions FamilySupportAction[]
}

// ─────────────────────────────────────────────
// DPDP data rights — erasure (§12) & access (§11)
// ─────────────────────────────────────────────

/// What a single erasure request covers. Anything narrower than `account` runs immediately;
/// `account` waits out a grace period first.
enum DataErasureScope {
  recordings
  chat
  tracker
  account
}

enum DataDeletionStatus {
  pending
  processing
  completed
  cancelled
  failed
}

enum DataExportStatus {
  pending
  ready
  downloaded
  failed
  expired
}

/// The record that an erasure was asked for and honoured. `userId` is SetNull rather than Cascade
/// on purpose: for a narrower scope the account lives on, and for an account erasure the tombstone
/// user survives — but either way this row has to outlive the data it destroyed, because it is the
/// only proof the request was acted on. It stores counts, never contents.
model DataDeletionRequest {
  id            String             @id @default(cuid())
  userId        String?
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Hashed, not stored plain: enough to answer "did this number ask to be erased?" without
  /// keeping the number that was just erased.
  phoneHash     String
  scope         DataErasureScope
  status        DataDeletionStatus @default(pending)
  requestedAt   DateTime           @default(now())
  /// When the worker may execute it. Equal to `requestedAt` for immediate scopes.
  scheduledFor  DateTime
  completedAt   DateTime?
  cancelledAt   DateTime?
  /// Per-category row counts destroyed, for the confirmation screen and for an audit.
  itemCounts    Json?
  failureReason String?

  @@index([status, scheduledFor])
  @@index([userId])
}

/// A staged copy of everything we hold about her, waiting to be downloaded once. The file itself
/// lives outside the database under DATA_EXPORT_DIR; `storagePath` is server-generated and never
/// sent to a client. `tokenHash` is the download secret — the token is shown to her exactly once,
/// in the response that creates this row, and only its hash is kept.
model DataExportRequest {
  id            String           @id @default(cuid())
  userId        String?
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  status        DataExportStatus @default(pending)
  tokenHash     String           @unique
  storagePath   String?
  sizeBytes     Int?
  /// After this the file is deleted by the retention job, downloaded or not.
  expiresAt     DateTime
  downloadedAt  DateTime?
  failureReason String?
  createdAt     DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

enum FcmPlatform {
  WEB
  ANDROID
  IOS
}

enum FcmTokenStatus {
  ACTIVE
  INACTIVE
}

model FcmToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String         @unique
  platform  FcmPlatform
  status    FcmTokenStatus @default(ACTIVE)
  deviceId  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, status])
}

model Session {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
}

enum OtpChallengePurpose {
  login
  signup
  /// Re-verification before an irreversible erasure, so a stolen session cannot delete an account.
  account_deletion
  /// Re-verification before an export, which is the inverse risk: it creates a portable copy of
  /// her entire health history, so a stolen session must not be able to ask for one.
  data_export
  /// A family member proving possession of their phone while claiming an invite link. Deliberately
  /// absent from `authPurposeSchema`, so it can never be driven through the public
  /// /auth/request-otp: the only guard on this purpose is a valid, unclaimed invite token, and that
  /// guard lives on the /family/join routes alone.
  family_join
}

enum OtpChallengeStatus {
  pending
  verified
  expired
  failed
}

model OtpChallenge {
  id                String             @id @default(cuid())
  phone             String
  userId            String?
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  purpose           OtpChallengePurpose
  provider          String
  providerSessionId String
  status            OtpChallengeStatus @default(pending)
  attemptCount      Int                @default(0)
  expiresAt         DateTime
  verifiedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([phone, createdAt])
  @@index([userId])
  @@index([status, expiresAt])
}

// ─────────────────────────────────────────────
// Family sharing — the caregiver companion app
// ─────────────────────────────────────────────
//
// One woman shares with at most one family member at a time. She mints a magic link, sends it over
// WhatsApp, and the first phone to verify an OTP against it claims the slot. Two rules are enforced
// by partial unique indexes rather than by application code, because both are reachable by two
// concurrent requests: one active member per user, and one pending invite per user. Prisma cannot
// express a partial index, so they live in the migration SQL — see the `family_sharing` migration.
//
// What crosses this boundary is banded, directional copy only ("Sleep ↓ · Lower this week"), never
// scores, symptom names, chat, or documents. The one place that translation happens is
// apps/api/src/family/digest.ts.

enum FamilyInviteStatus {
  pending
  accepted
  revoked
  expired
}

enum FamilyMemberStatus {
  active
  revoked
}

enum FamilyRelationship {
  partner
  child
  parent
  sibling
  friend
  other
}

enum FamilySupportActionKind {
  message
  call
  flowers
  chocolates
}

/// One outstanding magic link, single-claim. The raw token exists only in the URL fragment she
/// shares — we keep sha256 of it, the same way sessions are stored.
model FamilyInvite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String             @unique
  status    FamilyInviteStatus @default(pending)
  expiresAt DateTime

  /// Last time she actually shared the link. The invite gate's grace window is measured from this
  /// column and not from a client timer, so a reload, a second device, or a reinstall cannot buy
  /// more time before the gate re-opens.
  sharedAt   DateTime?
  shareCount Int       @default(0)

  acceptedAt DateTime?
  memberId   String?       @unique
  member     FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  /// Which version of the sharing-consent copy she agreed to when this link was minted. Bump it
  /// whenever the gate's wording changes materially — this row is the record of what she consented to.
  consentVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, expiresAt])
}

model FamilyMember {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  relationship FamilyRelationship

  /// A third party's personal data, held only for as long as the membership. Verified by OTP at
  /// join; never returned to the family client at all, and returned to her masked only.
  phone           String
  phoneVerifiedAt DateTime

  status    FamilyMemberStatus @default(active)
  revokedAt DateTime?

  lastSeenAt DateTime @default(now())

  /// Set by "Remind me later" on the support sheet; read by the reminder job.
  supportRemindAt DateTime?

  createdAt DateTime @default(now())

  invite         FamilyInvite?
  sessions       FamilySession[]
  supportActions FamilySupportAction[]

  @@index([userId, status])
  @@index([phone])
}

/// Mirrors `Session`, including the sha256 token hash, so the family cookie behaves exactly like
/// the patient and doctor ones. No `user` relation on purpose: a family session belongs to the
/// member, and dies with them by cascade.
model FamilySession {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  familyMemberId String
  member         FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  lastSeenAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([familyMemberId])
}

/// One recorded supportive action per member per day — what turns the Today CTA into
/// "✓ Support action completed", and what later tells her someone checked in.
model FamilySupportAction {
  id             String       @id @default(cuid())
  familyMemberId String
  member         FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind FamilySupportActionKind
  /// `dayKey()` — UTC midnight of the local calendar day, the same convention as every log table.
  date DateTime                @db.Date

  createdAt DateTime @default(now())

  /// Per *kind*, not per day: a family member may message her and send flowers on the same day, and
  /// collapsing those onto one row would silently overwrite the first. Re-tapping the same action is
  /// still idempotent, which caps this at four rows per member per day.
  @@unique([familyMemberId, date, kind])
  @@index([userId, date])
}

enum MenopauseStage {
  premenopause
  perimenopause
  menopause
  postmenopause
}

model HealthProfile {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth    DateTime?
  menopauseStage MenopauseStage?
  cycleStartDate DateTime?
  updatedAt      DateTime        @updatedAt
}

// ─────────────────────────────────────────────
// Onboarding assessment
// ─────────────────────────────────────────────

model AssessmentQuestion {
  id      String              @id @default(cuid())
  key     String              @unique
  prompt  String
  order   Int
  options AssessmentOption[]
  answers AssessmentAnswer[]
}

model AssessmentOption {
  id         String             @id @default(cuid())
  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  score      Int
  order      Int

  @@index([questionId])
}

enum AssessmentStatus {
  in_control
  further_assessment
}

model Assessment {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Int
  threshold   Int                @default(8)
  status      AssessmentStatus
  completedAt DateTime           @default(now())
  answers     AssessmentAnswer[]

  @@index([userId])
}

model AssessmentAnswer {
  id           String             @id @default(cuid())
  assessmentId String
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     AssessmentQuestion @relation(fields: [questionId], references: [id])
  optionIndex  Int
  optionLabel  String
  score        Int

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
}

// ─────────────────────────────────────────────
// Subscription
// ─────────────────────────────────────────────

enum SubscriptionPlan {
  monthly
  annual
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan?
  status    SubscriptionStatus @default(active)
  startedAt DateTime           @default(now())
  trialEndsAt DateTime?
  renewsAt  DateTime?
}

// ─────────────────────────────────────────────
// Dashboard
// ─────────────────────────────────────────────

model WellnessSnapshot {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  balanceScore Int
  summary      String?

  @@unique([userId, date])
  @@index([userId])
}

model DailyInsight {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  body       String
  authorName String?
  source     String?
  createdAt  DateTime @default(now())

  @@index([date])
}

// ─────────────────────────────────────────────
// Symptom tracking
// ─────────────────────────────────────────────

enum SymptomCategory {
  vasomotor
  sleep
  mood
  lifestyle
}

model Symptom {
  id       String              @id @default(cuid())
  key      String              @unique
  label    String
  category SymptomCategory
  active   Boolean             @default(true)
  entries  SymptomLogEntry[]
}

model SymptomLog {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime          @db.Date
  intensity Int // 1-7 overall intensity
  note      String?
  createdAt DateTime          @default(now())
  entries   SymptomLogEntry[]

  @@unique([userId, date])
  @@index([userId])
}

model SymptomLogEntry {
  id        String     @id @default(cuid())
  logId     String
  log       SymptomLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  symptomId String
  symptom   Symptom    @relation(fields: [symptomId], references: [id])

  @@unique([logId, symptomId])
  @@index([logId])
}

// ─────────────────────────────────────────────
// Weekly report
// ─────────────────────────────────────────────

model WeeklyReport {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime        @db.Date
  weekEnd   DateTime        @db.Date
  cohort    String? // e.g. "women 42-50 early perimenopause"
  createdAt DateTime        @default(now())
  metrics   WeeklyMetric[]

  @@unique([userId, weekStart])
  @@index([userId])
}

enum MetricKind {
  benchmark
  stat
}

model WeeklyMetric {
  id          String       @id @default(cuid())
  reportId    String
  report      WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  kind        MetricKind
  label       String
  value       Float
  unit        String?
  delta       String?
  cohortMedup Float? // cohort median for benchmark bars
  trend       Int[] // sparkline series for stat cards

  @@index([reportId])
}

// ─────────────────────────────────────────────
// Care direction
// ─────────────────────────────────────────────

model CarePath {
  id          String         @id @default(cuid())
  key         String         @unique
  label       String
  tag         String?
  description String?
  users       UserCarePath[]
}

enum CarePathStatus {
  recommended
  selected
  active
  completed
}

model UserCarePath {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  carePathId String
  carePath   CarePath       @relation(fields: [carePathId], references: [id])
  status     CarePathStatus @default(recommended)
  focusTags  String[]
  createdAt  DateTime       @default(now())

  @@unique([userId, carePathId])
  @@index([userId])
}

enum JourneyStageStatus {
  done
  active
  upcoming
}

model CareJourneyStage {
  id     String             @id @default(cuid())
  userId String
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage  String
  status JourneyStageStatus @default(upcoming)
  order  Int

  @@index([userId])
}

// ─────────────────────────────────────────────
// Specialists & booking
// ─────────────────────────────────────────────

enum SpecialistPortalRole {
  doctor
  admin
}

/// One row per practitioner — this is the person, not a service category. It carries both the
/// profile patients book against and that person's portal login, because they are the same human;
/// splitting them only bought a second `active` flag that could disagree with the first.
///
/// `portalRole = admin` is the exception: an ops login with no patient-facing profile. It is
/// excluded from every patient-facing query, so it never appears in the booking catalog.
model Specialist {
  id             String                    @id @default(cuid())
  key            String                    @unique // gynec | psych | nutri | riz
  name           String
  portalRole     SpecialistPortalRole      @default(doctor)
  /// Portal sign-in. Null username means this person has no login yet; `active = false` blocks
  /// both signing in and being booked, so there is one answer to "is this person switched on".
  username       String?                   @unique
  /// scrypt hash, `scrypt$N$r$p$salt$derivedKey` (see apps/api/src/doctorAuth.ts). Passwords are
  /// human-chosen and therefore low-entropy, so this is a slow KDF, not the SHA-256 used for
  /// session tokens.
  passwordHash      String?
  passwordUpdatedAt DateTime?
  lastLoginAt       DateTime?
  /// Lockout lives in the database, not in process memory: a restart must not silently void it.
  failedLoginCount  Int                    @default(0)
  lockedUntil       DateTime?
  sessions          SpecialistSession[]
  subtitle       String?
  role           String?
  specialization String?
  summary        String?
  experience     String?
  tag            String?
  imageUrl       String?
  active         Boolean                   @default(true)
  qualifications SpecialistQualification[]
  consultations  Consultation[]
  slots          ConsultationSlot[]
  expertAnswers  ExpertAnswer[]
  uploadedDocs   ConsultationDocument[]
  fcmTokens      SpecialistFcmToken[]
  notifications  DoctorNotification[]
}

/// Push tokens for the doctor portal. Separate from FcmToken because that one is keyed to a User
/// row (a patient) — a doctor is a Specialist and has no User row to hang a token off.
model SpecialistFcmToken {
  id           String         @id @default(cuid())
  specialistId String
  specialist   Specialist     @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  token        String         @unique
  platform     FcmPlatform
  status       FcmTokenStatus @default(ACTIVE)
  deviceId     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([specialistId, status])
}

enum DoctorNotificationType {
  consultation_booked
  consultation_cancelled
  consultation_rescheduled
  question_asked
}

/// The in-app notification feed for one doctor. Written alongside every push so the portal can
/// show what was sent even when the device push was missed, denied, or cleared.
model DoctorNotification {
  id             String                 @id @default(cuid())
  specialistId   String
  specialist     Specialist             @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  type           DoctorNotificationType
  title          String
  body           String
  url            String?
  consultationId String?
  questionId     String?
  readAt         DateTime?
  createdAt      DateTime               @default(now())

  @@index([specialistId, createdAt])
  @@index([specialistId, readAt])
}

model SpecialistSession {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  lastSeenAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@index([specialistId])
}

model SpecialistQualification {
  id           String     @id @default(cuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  label        String

  @@index([specialistId])
}

enum ConsultationStatus {
  pending
  confirmed
  completed
  cancelled
}

enum ConsultationCallProvider {
  livekit
}

enum ConsultationDocumentKind {
  prescription
  diet_plan
  care_plan
  suggestion
}

enum ConsultationCallStatus {
  waiting
  active
  ended
  failed
}

enum ConsultationRecordingStatus {
  starting
  recording
  processing
  ready
  failed
}

enum ConsultationRecordingRole {
  doctor
  patient
  /// Derived: the doctor and patient files mixed down to one track with ffmpeg. Has no egress
  /// of its own, so egressId stays null.
  mixed
}

model Consultation {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialistId String
  specialist   Specialist         @relation(fields: [specialistId], references: [id])
  scheduledAt  DateTime
  status       ConsultationStatus @default(pending)
  isFree       Boolean            @default(true)
  /// The end of the NMC 2020 three-year record floor, stamped when the patient asks to be erased.
  /// Until then this row is the reason her tombstone user still exists; after it, the retention job
  /// deletes the consultation outright. Null means "no erasure asked for, no clock running".
  purgeAfter   DateTime?
  createdAt    DateTime           @default(now())
  slot         ConsultationSlot?
  call         ConsultationCall?
  documents    ConsultationDocument[]

  @@index([userId])
  @@index([specialistId])
  @@index([purgeAfter])
}

/// A prescription, diet plan, care plan, or suggestion the doctor uploaded after the consultation.
/// Files live outside the database (CONSULTATION_DOC_DIR); `storagePath` is server-generated and
/// never sent to a client — every read goes through an ownership-checked route.
model ConsultationDocument {
  id             String                   @id @default(cuid())
  consultationId String
  consultation   Consultation             @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  kind           ConsultationDocumentKind
  title          String?
  /// The name the doctor's device gave the file. Display only — never used to build a path.
  originalName   String
  mimeType       String
  sizeBytes      Int
  storagePath    String
  uploadedById   String
  uploadedBy     Specialist               @relation(fields: [uploadedById], references: [id])
  /// Soft delete: a withdrawn prescription stays on disk for the medico-legal trail.
  deletedAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([consultationId, deletedAt])
}

model ConsultationCall {
  id                 String                   @id @default(cuid())
  consultationId     String                   @unique
  consultation       Consultation             @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  provider           ConsultationCallProvider @default(livekit)
  roomName           String                   @unique
  status             ConsultationCallStatus   @default(waiting)
  doctorStartedAt    DateTime?
  patientJoinedAt    DateTime?
  recordingStartedAt DateTime?
  endedAt            DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  recordings         ConsultationRecording[]
  consents           ConsultationCallConsent[]

  @@index([status])
}

/// One row per participant. Each speaker is recorded to its own audio file via
/// LiveKit participant egress, so Phase 2 transcription gets speaker-separated
/// audio without a diarization step.
model ConsultationRecording {
  id                  String                      @id @default(cuid())
  consultationCallId  String
  consultationCall    ConsultationCall            @relation(fields: [consultationCallId], references: [id], onDelete: Cascade)
  participantRole     ConsultationRecordingRole
  participantIdentity String
  egressId            String?                     @unique
  status              ConsultationRecordingStatus @default(starting)
  storagePath         String?
