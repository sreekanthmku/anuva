enum QuestionStatus {
  pending
  answered
}

/// `userId` is how the asker gets back to her own thread, and is the ONE field that must never
/// reach the doctor portal. No /doctor route selects it, and no shared schema has a slot for it.
model AnonymousQuestion {
  id         String         @id @default(cuid())
  userId     String? // nullable: anonymity preserved
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  topic      String
  body       String
  status     QuestionStatus @default(pending)
  createdAt  DateTime       @default(now())
  answeredAt DateTime?
  answers    ExpertAnswer[]

  @@index([topic])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model ExpertAnswer {
  id         String            @id @default(cuid())
  questionId String
  question   AnonymousQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// Which specialist signed the answer. Null for answers written with the shared admin key or
  /// seeded by hand; `expertName`/`expertRole` are denormalized so the card renders either way.
  specialistId String?
  specialist   Specialist?     @relation(fields: [specialistId], references: [id], onDelete: SetNull)
  expertName String
  expertRole String?
  body       String
  verified   Boolean           @default(false)
  answeredAt DateTime          @default(now())

  @@index([questionId])
  @@index([specialistId])
}

